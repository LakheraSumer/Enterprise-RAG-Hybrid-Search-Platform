# Copy to .env (never commit .env). All settings are optional.
EMBEDDING_PROVIDER=fastembed          # fastembed | hashing
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER=cross-encoder                # cross-encoder | none
MODEL_CACHE_DIR=.cache/models

# PostgreSQL + pgvector (in-memory store if unset)
DATABASE_URL=postgresql://rag:rag@localhost:5433/rag
# Redis answer cache (in-memory cache if unset)
REDIS_URL=redis://localhost:6380/0

CHUNK_TOKENS=200
CHUNK_OVERLAP=40
DENSE_WEIGHT=0.5
CANDIDATE_K=30
MIN_CONFIDENCE=0.2

# Optional OpenAI-compatible LLM. Without it, answers are extractive with citations.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
PRICE_PER_1K_INPUT_TOKENS=0
PRICE_PER_1K_OUTPUT_TOKENS=0
